<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
	<PublishTrimmed>True</PublishTrimmed>
	<PublishAot>True</PublishAot>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <Optimize>True</Optimize>
    <Tailcalls>True</Tailcalls>
  </PropertyGroup>

  <PropertyGroup Label="Avalonia">
    <AvaloniaNameGeneratorIsEnabled>False</AvaloniaNameGeneratorIsEnabled>
    <EnableAvaloniaXamlCompilation>False</EnableAvaloniaXamlCompilation>
    <AvaloniaXamlReportImportance>High</AvaloniaXamlReportImportance>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="GUI\index.html" />
    <EmbeddedResource Include="GUI\style.css" />
    <Compile Include="GUI\HtmlWindow.fs" />
    <Compile Include="CLI\IOutput.fs" />
    <Compile Include="CLI\Menu.fs" />
    <Compile Include="Language\Vocab.fs" />
    <Compile Include="Language\Annotations.fs" />
    <Compile Include="Language\Declension\Deutsch.fs" />
    <Compile Include="Language\Declension\English.fs" />
    <Compile Include="Language\VerbDownloader.fs" />
    <Compile Include="Language\Wordlist.fs" />
    <Compile Include="Scheduler\CardScheduler.fs" />
    <Compile Include="Scheduler\CardStack.fs" />
    <Compile Include="Scheduler\ReviewSession.fs" />
    <Compile Include="Decks\Shared.fs" />
    <Compile Include="Decks\PersonalPronouns.fs" />
    <Compile Include="Decks\PossessivePronouns.fs" />
    <Compile Include="Decks\Articles.fs" />
    <Compile Include="Decks\Vocab.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="11.3.11" />
    <PackageReference Include="Avalonia.FuncUI" Version="1.5.2" />
    <PackageReference Include="Avalonia.HtmlRenderer" Version="11.2.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.11" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Program.fs" />
    <Folder Include="GUI\" />
  </ItemGroup>

</Project>
