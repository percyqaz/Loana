<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
	<PublishTrimmed>True</PublishTrimmed>
	<PublishAot>True</PublishAot>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <Optimize>True</Optimize>
    <Tailcalls>True</Tailcalls>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Language\Vocab.fs" />
    <Compile Include="Language\AnnotationTree.fs" />
    <Compile Include="Language\Declension\Deutsch.fs" />
    <Compile Include="Language\Declension\English.fs" />
    <Compile Include="Language\VerbInflections.fs" />
    <Compile Include="Language\VerbDownloader.fs" />
    <Compile Include="Language\CardMeta.fs" />
    <Compile Include="Data\ReviewSchedule.fs" />
    <Compile Include="Data\Words.fs" />
    <Compile Include="Data\Verbs.fs" />
    <Compile Include="Vocab\VocabCards.fs" />
    <Compile Include="Vocab\VocabDeck.fs" />
    <Compile Include="Verbs\VerbCards.fs" />
    <Compile Include="Verbs\VerbCache.fs" />
  </ItemGroup>

</Project>
