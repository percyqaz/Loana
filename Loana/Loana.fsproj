<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
	<PublishTrimmed>True</PublishTrimmed>
	<PublishAot>True</PublishAot>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <Optimize>True</Optimize>
    <Tailcalls>True</Tailcalls>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="CLI\Console.fs" />
    <Compile Include="CLI\StudySession.fs" />
    <Compile Include="CLI\Menu.fs" />
    <Compile Include="Language\Vocab.fs" />
    <Compile Include="Language\Annotations.fs" />
    <Compile Include="Language\Declension\Deutsch.fs" />
    <Compile Include="Language\Declension\English.fs" />
    <Compile Include="Language\VerbDownloader.fs" />
    <Compile Include="Language\WordBank.fs" />
    <Compile Include="Study\ReviewSchedule.fs" />
    <Compile Include="Study\ReviewSession.fs" />
    <Compile Include="Study\VocabCards.fs" />
    <Compile Include="Features\Quizzes\Shared.fs" />
    <Compile Include="Features\Quizzes\Articles.fs" />
    <Compile Include="Features\Quizzes\PersonalPronouns.fs" />
    <Compile Include="Features\Quizzes\ReflexivePronouns.fs" />
    <Compile Include="Features\Quizzes\PossessivePronouns.fs" />
    <Compile Include="Features\Vocab.fs" />
    <Compile Include="Features\Quizzes.fs" />
    <Compile Include="Features\Verbs.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

</Project>
