<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        xmlns:loana="clr-namespace:Loana.GUI"
        mc:Ignorable="d"
        x:Class="Loana.GUI.MainWindow"
		Width="500"
		Height="500"
        Title="Loana">
	<Grid RowDefinitions="*,Auto">
		<SplitView IsPaneOpen="False"
			x:Name="Split"
			DisplayMode="Overlay"
            OpenPaneLength="300">
			<loana:Terminal x:Name="MainDisplay" />
			<SplitView.Pane>
				<loana:Terminal x:Name="Log" />
			</SplitView.Pane>
		</SplitView>
		<TextBox
			Grid.Row="1"
			x:Name="Input"
			FontFamily="Consolas"
			FontSize="14"
			Background="Black"
			Foreground="LightGray"
			HorizontalAlignment="Stretch"
			VerticalAlignment="Bottom"
			Height="30"
			AcceptsReturn="False"
			TextWrapping="NoWrap"
			Margin="1" />
	</Grid>
</Window>