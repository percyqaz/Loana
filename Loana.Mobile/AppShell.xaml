<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Loana.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sf="clr-namespace:Syncfusion.Maui.Toolkit.SegmentedControl;assembly=Syncfusion.Maui.Toolkit"
    xmlns:pages="clr-namespace:Loana.Mobile.Pages"
    Shell.FlyoutBehavior="Flyout"
    Title="Loana.Mobile">

    <ShellContent
        Title="Dashboard"
        Icon="{StaticResource IconDashboard}"
        ContentTemplate="{DataTemplate pages:DashboardPage}"
        Route="main" />

    <ShellContent
        Title="Sync"
        Icon="{StaticResource IconMeta}"
        ContentTemplate="{DataTemplate pages:MainPage}"
        Route="manage" />
</Shell>