<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sf="clr-namespace:Syncfusion.Maui.Toolkit.TextInputLayout;assembly=Syncfusion.Maui.Toolkit"
             xmlns:pageModel="clr-namespace:Loana.Mobile.PageModels"
             xmlns:models="clr-namespace:Loana.Mobile.Models"
             xmlns:controls="clr-namespace:Loana.Mobile.Pages.Controls"
             x:DataType="pageModel:ReviewPageModel"
             x:Class="Loana.Mobile.Pages.ReviewPage"
             x:Name="ReviewPageRoot"
             Title="{Binding RemainingCards, StringFormat='Review ({0} remaining)'}">
    <ScrollView>
        <ScrollView.GestureRecognizers>
            <SwipeGestureRecognizer Direction="Left" Command="{Binding SwipedLeftCommand}" />
            <SwipeGestureRecognizer Direction="Down" Command="{Binding SwipedDownCommand}" />
            <SwipeGestureRecognizer Direction="Up" Command="{Binding SwipedUpCommand}" />
            <SwipeGestureRecognizer Direction="Right" Command="{Binding SwipedRightCommand}" />
            <TapGestureRecognizer NumberOfTapsRequired="1" Command="{Binding TappedCommand}" />
        </ScrollView.GestureRecognizers>
        <controls:FlashcardView BindingContext="{Binding CurrentCard}"
                                   Revealed="{Binding BindingContext.ShowBack, Source={x:Reference ReviewPageRoot}}" />
    </ScrollView>
</ContentPage>